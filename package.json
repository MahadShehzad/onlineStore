{
  "name": "online-store",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "kill-port 4200",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preapi": "kill-port 5103",
    "api": "dotnet run --project server --launch-profile http",
    "db:update": "dotnet ef database update --project server",
    "predev": "kill-port 4200 5103",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:api\" \"npm:start\"",
    "stop": "kill-port 4200 5103",
    "serve:ssr:onlineStore": "node dist/onlineStore/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.5",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
